# ============================================
# yh-istream 生产环境配置模板
# 使用方法：复制本文件为 .env，填入真实值
#   cp .env.example .env
#   vim .env  # 修改为生产密码
# ============================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=your_mysql_password_here

# ---------- Redis ----------
REDIS_PASSWORD=your_redis_password_here

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=https://your-domain.com